# Model provider key used by the Mastra agent (src/mastra/agents/weather-agent.ts).
# Also powers voice input's fallback path (src/app/api/transcribe/route.ts):
# Chrome, Edge, Opera and Safari dictate through the browser's own Web Speech
# API for free; Firefox has none enabled and posts the clip to Groq's
# whisper-large-v3-turbo instead, billed at $0.04 per hour of audio with a
# 10-second minimum per request. Unset, the mic still works everywhere except
# Firefox, which gets a 501.
GROQ_API_KEY=

# Supabase Auth. Both are safe to expose to the browser — the anon key is
# designed to be public and is what Row Level Security is enforced against.
# Supabase dashboard: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase Postgres connection string. Required on Vercel — without it the app
# falls back to a local file:./mastra.db, which does not survive a serverless
# cold start. Use the TRANSACTION POOLER string (port 6543), not direct 5432.
# Supabase dashboard: Project Settings > Database > Connection string > Transaction pooler
DATABASE_URL=

# Local dev only, ignored when DATABASE_URL is set. `next dev` and `mastra dev`
# (Studio) run with different working directories, so a relative sqlite path
# produces two separate databases and Studio can't see the app's traffic.
# Point this at one absolute path to keep them in sync. Forward slashes on Windows.
# MASTRA_DB_URL=file:C:/path/to/your/project/mastra.db

# Embeddings for syllabus retrieval (google/gemini-embedding-001). Free tier on
# Google AI Studio — no card, rate-limited rather than billed. Get one at
# https://aistudio.google.com/apikey
# Without this (or without DATABASE_URL) the syllabus search tool is not
# registered and Aristo answers from the model alone, so retrieval silently
# does nothing.
# GOOGLE_GENERATIVE_AI_API_KEY also works if you prefer that name.
GOOGLE_API_KEY=

# Optional: sends observability traces to Mastra Platform when set.
# MASTRA_PLATFORM_ACCESS_TOKEN=
