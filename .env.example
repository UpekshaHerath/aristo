# Model provider key used by the Mastra agent (src/mastra/agents/weather-agent.ts)
GROQ_API_KEY=

# Supabase Postgres connection string. Required on Vercel — without it the app
# falls back to a local file:./mastra.db, which does not survive a serverless
# cold start. Use the TRANSACTION POOLER string (port 6543), not direct 5432.
# Supabase dashboard: Project Settings > Database > Connection string > Transaction pooler
DATABASE_URL=

# Optional: sends observability traces to Mastra Platform when set.
# MASTRA_PLATFORM_ACCESS_TOKEN=
